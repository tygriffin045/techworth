{
  "name": "reladraw-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^4",
    "reladraw": "0.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "cd \"$(git rev-parse --show-toplevel)/apps/reladraw-live\" && bun run check"
  },
  "prettier": {
    "printWidth": 110
  }
}
